`timescale 1ns/100ps // 1 ns time unit, 100 ps resolution
// `include "task_1.v"

module task_4_tb;
	
	reg clk, reset, data, ack;

    wire counting, done;
	wire[3:0] count;
	wire[15:0] cn;

	task_4 tsk0
	(
		.clk(clk),
        .reset(reset),
		.data(data),
		.ack(ack),
		.count(count),
		.counting(counting),
		.done(done)
	);


	initial
	begin
	$display ("###################################################");
	$display ("Start TestBench");
	clk = 0;
	reset = 1;
	data = 0;
	end

	initial 
	begin
		$dumpfile ("wave.vcd");
		$dumpvars(0, task_4_tb);
	end

	always
		#5 clk = !clk;

	initial begin

		@ (posedge clk);

		reset <= 0;
		data <= 1;

		@ (posedge clk);

		data <= 0;

		@ (posedge clk);
		@ (posedge clk);

		data <= 1;

		@ (posedge clk);
		@ (posedge clk);

		data <= 0;

		@ (posedge clk);

		data <= 1;

		@ (posedge clk);

		data <= 0;

		@ (posedge clk);
		@ (posedge clk);
		@ (posedge clk);

		data <= 1;

		@(posedge clk);

		data <= 0;

		repeat (2000)
		begin
			@(posedge clk);
		end

		ack <= 0;

		@(posedge clk);
		@(posedge clk);
		@(posedge clk);

		ack <= 1;

		@(posedge clk);

		data <= 1;
		ack <= 0;

		@(posedge clk);
		@(posedge clk);

		data <= 0;

		@(posedge clk);
		
		data <= 1;	

		@(posedge clk);
		@(posedge clk);
		@(posedge clk);
		@(posedge clk);

		data <= 0;

		@(posedge clk);
		@(posedge clk);
		@(posedge clk);

		#20
		$display ("###################################################");
		$finish();
	end

	initial begin
		$monitor("t=%-4d: clk = %h, reset = %h, data = %h, count = %d, counting = %d, done = %d, ack = %d", $time, clk, reset, data, count, counting,
		done, ack);
	end

endmodule